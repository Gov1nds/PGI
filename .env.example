# PGI Hub Frontend Environment Variables
# Copy to .env and fill in values

# Backend API base URL (default: same-origin for proxy setup)
VITE_API_BASE_URL=

# SSE endpoint URL (default: ${VITE_API_BASE_URL}/api/v1/events/stream)
VITE_SSE_ENDPOINT=

# Analytics telemetry endpoint (default: ${VITE_API_BASE_URL}/api/v1/analytics/telemetry)
VITE_ANALYTICS_ENDPOINT=

# Enable debug tooling in production (default: false)
VITE_ENABLE_DEVTOOLS=false
